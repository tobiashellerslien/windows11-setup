{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "builtin",
        "source": "Windows",
        "padding": {
            "top": 1,
            "left": 2,
            "right": 4
        }
    },

    "display": {
        "separator": "  ",
        "color": {
            "keys": "light_blue",
            "title": "light_cyan",
            "separator": "bright_black",
            "output": "white"
        },
        "key": {
            "type": "icon",
            "width": 4
        }
    },

    "modules": [
        "break",
        "break",
        {
            "type": "title",
            "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}"
        },
        {
            "type": "custom",
            "format": "{#bright_black}────────────────────────────{#}"
        },
        {
            "type": "os",
            "format": "{pretty-name}"
        },
        {
            "type": "host",
            "format": "{name}"
        },
        {
            "type": "cpu",
            "format": "{name}"
        },
        {
            "type": "gpu",
            "hideType": "unknown",
            "format": "{name}"
        },
        {
            "type": "memory",
            "format": "{used} / {total}"
        },
        {
            "type": "disk",
            "folders": "C:\\",
            "format": "{size-used} / {size-total} ({size-percentage})"
        },
        {
            "type": "display",
            "format": "{width}×{height} @ {refresh-rate} Hz"
        },
        "uptime",
        "shell",
        "terminal",
        "break",
        "colors"
    ]
}
